NODE_ENV=development

FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4

GITHUB_TOKEN=

APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io

BRANDFETCH_API_KEY=
BRANDFETCH_BASE_URL=https://api.brandfetch.io

OUTPUT_DIR=output
DATA_DIR=data

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=phil@thegogrow.ch,nunezkathleenm@gmail.com

# Absolute site URL used to build links (e.g. the claim/removal outreach link).
# Falls back to https://$VERCEL_URL on Vercel, or http://localhost:3001 locally.
PUBLIC_BASE_URL=

RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
# Must be an address on a domain verified in Resend (SPF/DKIM/DMARC set up).
RESEND_FROM_EMAIL=

# Safety switch for outreach sending. Defaults to true: sends are redirected to
# OUTREACH_TEST_INBOX_EMAIL instead of the real contact. Set to "false" only
# once the full send -> follow-up -> reply-stop cycle has been tested end to end.
OUTREACH_DRY_RUN=true
OUTREACH_TEST_INBOX_EMAIL=

# Shared secret the Supabase pg_cron follow-up job sends as the x-cron-secret
# header when it calls /api/outreach-followup. See docs/supabase-schema.sql.
OUTREACH_CRON_SECRET=
